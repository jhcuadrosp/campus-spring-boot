# Estructura principal del monorepo
/*
!/.gitignore
!/.editorconfig
/AGENTS.md
/COURSE-CONVENTIONS.md
!/README.md
!/sessions/

# Documentación local de cada sesión
/sessions/*/docs/

# Salidas de compilación dentro de las sesiones
/sessions/**/target/
/sessions/**/out/
/sessions/**/bin/
/sessions/**/*.class

# IntelliJ IDEA, Eclipse/STS, VS Code y NetBeans
/sessions/**/.idea/
/sessions/**/*.iml
/sessions/**/*.ipr
/sessions/**/*.iws
/sessions/**/.classpath
/sessions/**/.project
/sessions/**/.settings/
/sessions/**/.factorypath
/sessions/**/.vscode/
/sessions/**/nbproject/private/

# Logs y archivos del sistema
/sessions/**/*.log
/sessions/**/.DS_Store
/sessions/**/Thumbs.db

# Secretos y datos locales de los futuros proyectos
/sessions/**/.env
/sessions/**/.env.*
!/sessions/**/.env.example
!/sessions/**/.env.sample
/sessions/**/application-local.*
/sessions/**/application-secret*
/sessions/**/secrets/
/sessions/**/*.key
/sessions/**/*.pem
/sessions/**/*.p12
/sessions/**/*.pfx
/sessions/**/*.jks
/sessions/**/*.keystore
/sessions/**/*.mv.db
/sessions/**/*.trace.db
